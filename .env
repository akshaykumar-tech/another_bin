# 5x acceleration dry paper (scripts/accel5x_dry_paper.py) — ALL mix, IST 05:30 entry
# Dry = same direction as 5x signal | Live twist: BTC green=same, red=mirror (no SL/TP)
ACCEL5X_DRY_OUT_DIR=data/aws/accel5x_dry
ACCEL5X_LIVE_ENABLED=false
ACCEL5X_MIN_MULT=5
ACCEL5X_MIN_BASE_PCT=0.3
ACCEL5X_MAX_TRADES=30
ACCEL5X_FEE_RT=0.0008
ACCEL5X_SLIP_BPS=1.0
ACCEL5X_FAPI=https://fapi.binance.com
ACCEL5X_SCAN_SLEEP=0.006
# Live sizing when ACCEL5X_LIVE_ENABLED=true → uses LIVE_NOTIONAL_USDT, LIVE_MAX_OPEN, etc.

