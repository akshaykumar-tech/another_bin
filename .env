# PB9 combo CONT pullback (scripts/pb9_combo_bot.py)
# A: prior |c2c|>50% → CONT @ open±9% first 4h UTC
# B: cum2d |move|>50% → CONT @ open±9% full day (no A fill same sym/day)
# Dry: PB9_LIVE_ENABLED=false | Live: PB9_LIVE_ENABLED=true + BINANCE_API_KEY/SECRET
PB9_LIVE_ENABLED=true
PB9_FAPI=https://fapi.binance.com
PB9_OUT_DIR=data/aws/pb9_combo
PB9_NOTIONAL_USDT=6
PB9_THR_A=50
PB9_THR_B=50
PB9_PB_PCT=9
PB9_MAX_OPEN_POSITIONS=20
PB9_POLL_SEC=15
PB9_SCAN_DELAY_SEC=90
PB9_FEE_RT=0.0008
PB9_LEVERAGE_CAP=20
PB9_FLATTEN_RETRIES=4
PB9_MAX_DAILY_LOSS_USDT=15
PB9_DAILY_LOOKBACK_DAYS=10

