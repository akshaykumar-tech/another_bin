UPBIT_ANNOUNCEMENTS_API_URL=https://api-manager.upbit.com/api/v1/announcements
UPBIT_POLL_INTERVAL_SECONDS=7
UPBIT_ANNOUNCEMENTS_API_PER_PAGE=1
UPBIT_ANNOUNCEMENTS_ONLY_LATEST=true

AUTO_TRADING_ENABLED=true
AUTO_TRADING_DRY_RUN=false
# Disabled for speed: RecentMove filter adds ~50-200ms HTTP call per token on the critical path.
AUTO_TRADING_RECENT_MOVE_FILTER_ENABLED=false
AUTO_TRADING_RECENT_MOVE_LOOKBACK_SECONDS=5
AUTO_TRADING_RECENT_MOVE_SKIP_PERCENT=15
AUTO_TRADING_ULTRA_FAST_FIXED_MARGIN_USDT=20

# --- Whale burst bot (cmd/whale) — sim tick + opposite live when REVERSE_TRADE ---
WHALE_DRY_RUN=true
WHALE_REVERSE_TRADE=true
WHALE_REVERSE_LIVE=true
# Live margin = available balance × this % (4 USDT → 1, 10 USDT → 2.5, always 25%)
WHALE_ALLOCATION_PERCENT=25
# Fixed margin overrides % — leave empty to use ALLOCATION_PERCENT only
WHALE_MARGIN_USDT=
WHALE_LEVERAGE=10
# Live reverse uses symbol max leverage, capped here (125 = as high as Binance allows per coin)
WHALE_MAX_LEVERAGE=125
WHALE_REVERSE_SL_PERCENT=1.5
# Sim/paper only — dry-run margin base (live uses balance × alloc or MARGIN_USDT)
WHALE_CAPITAL_USDT=1000
WHALE_DRY_SIM_MODE=tick
WHALE_TRADE_LOG=whale-trades.log
