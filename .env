UPBIT_POLL_INTERVAL_SECONDS=7
UPBIT_ANNOUNCEMENTS_API_PER_PAGE=1
UPBIT_ANNOUNCEMENTS_ONLY_LATEST=true

AUTO_TRADING_ENABLED=true
AUTO_TRADING_DRY_RUN=false
# Disabled for speed: RecentMove filter adds ~50-200ms HTTP call per token on the critical path.
AUTO_TRADING_RECENT_MOVE_FILTER_ENABLED=false
AUTO_TRADING_RECENT_MOVE_LOOKBACK_SECONDS=5
AUTO_TRADING_RECENT_MOVE_SKIP_PERCENT=15
AUTO_TRADING_ULTRA_FAST_FIXED_MARGIN_USDT=20

# --- Whale burst bot (cmd/whale) — sim tick + opposite live when REVERSE_TRADE ---
WHALE_DRY_RUN=true
WHALE_REVERSE_TRADE=true
# Real Binance orders when dry_run + reverse_live (opposite if REVERSE_TRADE)
WHALE_REVERSE_LIVE=false
# Live margin = available balance × this % (4 USDT → 1, 10 USDT → 2.5, always 25%)
WHALE_ALLOCATION_PERCENT=25
# Fixed margin overrides % — leave empty to use ALLOCATION_PERCENT only
WHALE_MARGIN_USDT=
WHALE_LEVERAGE=10
# Live reverse uses symbol max leverage, capped here (125 = as high as Binance allows per coin)
WHALE_MAX_LEVERAGE=125
WHALE_REVERSE_SL_PERCENT=1.5
# Sim/paper only — dry-run margin base (live uses balance × alloc or MARGIN_USDT)
WHALE_CAPITAL_USDT=1000
WHALE_DRY_SIM_MODE=tick
WHALE_TRADE_LOG=whale-trades.log
WHALE_FOCUS_COOLDOWN_SEC=120

# --- Early watch bot (cmd/whale-early) — 300 lowest-volume perps ---
EARLY_DRY_RUN=true
EARLY_LIVE_TRADE=false
EARLY_DRY_SAME=true
EARLY_DRY_REVERSE_LIMIT=false
EARLY_MIN_VOL_ACCEL=3
EARLY_TAKE_PROFIT_PCT=0.93
EARLY_LIMIT_FILL_SEC=1800
EARLY_SAME_MARGIN_USDT=1
EARLY_SAME_LEVERAGE=10
EARLY_REVERSE_MARGIN_USDT=1
EARLY_REVERSE_LEVERAGE=10
EARLY_NOTIONAL_USDT=10
EARLY_MAX_OPEN_LIVE=3
EARLY_MARGIN_USDT=1
EARLY_LEVERAGE=10
EARLY_MAX_LEVERAGE=50
EARLY_CAPITAL_USDT=1000
EARLY_WATCHLIST_MODE=lowest_volume
EARLY_WATCHLIST_SIZE=300
EARLY_RULE=quiet_flat
EARLY_DIRECTION=trend_1h
EARLY_TRADE_LOG=early-trades.log
EARLY_FOCUS_COOLDOWN_SEC=120

# --- Live paper detector (scripts/live_paper.py) — 300 symbols, 4 WS connections ---
LIVE_PAPER_WATCHLIST_SIZE=300
LIVE_PAPER_WS_CHUNK=80
LIVE_PAPER_PRE_THRESH=0.02
LIVE_PAPER_EVENT_THRESH=0.06
LIVE_PAPER_WINDOW_SEC=60
LIVE_PAPER_COOLDOWN_SEC=3600
