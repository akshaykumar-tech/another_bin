UPBIT_ANNOUNCEMENTS_ONLY_LATEST=true

AUTO_TRADING_ENABLED=true
AUTO_TRADING_DRY_RUN=false
# Disabled for speed: RecentMove filter adds ~50-200ms HTTP call per token on the critical path.
AUTO_TRADING_RECENT_MOVE_FILTER_ENABLED=false
AUTO_TRADING_RECENT_MOVE_LOOKBACK_SECONDS=5
AUTO_TRADING_RECENT_MOVE_SKIP_PERCENT=15
AUTO_TRADING_ULTRA_FAST_FIXED_MARGIN_USDT=20

# Global live sizing — shared by ACCEL5X / TPB live bots
LIVE_NOTIONAL_USDT=6
LIVE_MAX_OPEN=30
LIVE_MIN_LEVERAGE=10
LIVE_MARGIN_BUFFER=1.05
LIVE_RECONCILE_SEC=60
LIVE_ALGO_WORKING_TYPE=CONTRACT_PRICE
LIVE_SL_PCT=8
LIVE_TP_PCT=1.5

# 5x acceleration dry paper (scripts/accel5x_dry_paper.py) — IST 05:30 entry
# BTC twist dry+live: green=same, red=mirror | HYB5 entry | no SL/TP
ACCEL5X_DRY_OUT_DIR=data/aws/accel5x_dry
ACCEL5X_LIVE_ENABLED=false
ACCEL5X_ENTRY_MODE=hyb5
ACCEL5X_HYB_ADVERSE_PCT=5
ACCEL5X_HYB_POLL_SEC=30
# Full-day watch (86400=24h). 0=instant fallback on first poll if no 5% touch yet.
ACCEL5X_HYB_OPEN_AFTER_SEC=86400
ACCEL5X_MIN_MULT=5
ACCEL5X_MIN_BASE_PCT=0.3
ACCEL5X_MAX_TRADES=30
ACCEL5X_FEE_RT=0.0008
ACCEL5X_SLIP_BPS=1.0
ACCEL5X_FAPI=https://fapi.binance.com
ACCEL5X_SCAN_SLEEP=0.006
# Live sizing when ACCEL5X_LIVE_ENABLED=true → uses LIVE_NOTIONAL_USDT, LIVE_MAX_OPEN, etc.

# Trend + Pullback: dry original + live sync-mirror (scripts/trend_pullback_bot.py)
TPB_DRY_OUT_DIR=data/aws/trend_pullback
TPB_LIVE_ENABLED=false
TPB_WATCHLIST_MODE=all_perps
TPB_WATCHLIST_SIZE=300
