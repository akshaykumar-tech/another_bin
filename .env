TPB_BOOTSTRAP_BARS=250
TPB_MARK_POLL_SEC=45
TPB_FAPI=https://fapi.binance.com
TPB_WS_ROOT=wss://fstream.binance.com

# ORB 30m top-mover breakout (scripts/orb30_bot.py)
ORB30_LIVE_ENABLED=true
ORB30_FAPI=https://fapi.binance.com
ORB30_OUT_DIR=data/aws/orb30
ORB30_NOTIONAL_USDT=6
ORB30_TP_PCT=10
ORB30_SL_PCT=10
ORB30_MAX_TRADES_PER_SYM=3
ORB30_MAX_OPEN_POSITIONS=15
# false = backtest parity (multi re-entry); true = only enter after price returns inside ORB
ORB30_FRESH_BREAKOUT=false
ORB30_MAX_ENTRY_SLIP_PCT=0.35
ORB30_EXCHANGE_BRACKETS=true
