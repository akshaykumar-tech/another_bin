# Trading bots — copy to .env and fill keys

BINANCE_API_KEY=
BINANCE_API_SECRET=

# Global live sizing — shared by ACCEL5X / TPB live bots
LIVE_NOTIONAL_USDT=6
LIVE_MAX_OPEN=40
LIVE_MIN_LEVERAGE=10
LIVE_MARGIN_BUFFER=1.05
LIVE_RECONCILE_SEC=60
LIVE_ALGO_WORKING_TYPE=CONTRACT_PRICE
LIVE_SL_PCT=8
LIVE_TP_PCT=1.5

# 5x acceleration dry paper (scripts/accel5x_dry_paper.py)
ACCEL5X_DRY_OUT_DIR=data/aws/accel5x_dry
ACCEL5X_LIVE_ENABLED=false
ACCEL5X_ENTRY_MODE=hyb5
ACCEL5X_HYB_ADVERSE_PCT=5
ACCEL5X_HYB_POLL_SEC=30
# Full-day watch (86400=24h). 0=instant fallback on first poll if no 5% touch yet.
ACCEL5X_HYB_OPEN_AFTER_SEC=86400
ACCEL5X_MIN_MULT=5
ACCEL5X_MIN_BASE_PCT=0.3
ACCEL5X_MAX_TRADES=30
ACCEL5X_FEE_RT=0.0008
ACCEL5X_SLIP_BPS=1.0
# BTC twist (dry+live): GREEN=same | RED=mirror | exit next day, no SL/TP
# HYB5: first adverse% touch since day open -> trigger entry (latched); else market @ OPEN_AFTER
# Live uses LIVE_NOTIONAL_USDT, LIVE_MAX_OPEN, LIVE_MIN_LEVERAGE, LIVE_MARGIN_BUFFER, LIVE_RECONCILE_SEC

# ORB 30m breakMid (scripts/orb30_bot.py)
# Dry: ORB30_LIVE_ENABLED=false | Live: ORB30_LIVE_ENABLED=true
ORB30_LIVE_ENABLED=false
ORB30_FAPI=https://fapi.binance.com
ORB30_OUT_DIR=data/aws/orb30
ORB30_NOTIONAL_USDT=10
# breakMid: TP5 / SL15 / TIME after 12×5m bars (60m); LIMIT @ ORB mid
ORB30_TP_PCT=5
ORB30_SL_PCT=15
ORB30_HOLD_BARS=12
ORB30_MAX_TRADES_PER_SYM=50
ORB30_MAX_OPEN_POSITIONS=15
# Legacy knob (logs only). Live ENTRY is ALWAYS GTC LIMIT @ mid — never market chase.
ORB30_MAX_ENTRY_SLIP_PCT=0.35
# Place Binance STOP/TP algo orders after entry (poll is backup; TIME is poll-only)
ORB30_EXCHANGE_BRACKETS=true
ORB30_WORKING_TYPE=MARK_PRICE
# Live only enters if today's paper 5m breakMid replay agrees on that side
ORB30_PAPER_GATE=true
# Paper sync: close wrong live pos; place/cancel LIMIT @ mid (seconds)
ORB30_ORDER_AUDIT_SEC=600
ORB30_LOOKBACK_DAYS=7
ORB30_POLL_SEC=3
ORB30_SCAN_DELAY_SEC=120
ORB30_FEE_RT=0.0008
ORB30_LEVERAGE_CAP=20
ORB30_FLATTEN_RETRIES=4
ORB30_MAX_DAILY_LOSS_USDT=10

# Triple-combo overnight (scripts/triple_combo_bot.py)
# Dry: TC_LIVE_ENABLED=false | Live: TC_LIVE_ENABLED=true
TC_LIVE_ENABLED=false
TC_FAPI=https://fapi.binance.com
TC_OUT_DIR=data/aws/triple_combo
TC_NOTIONAL_USDT=10
TC_GAIN_FADE_PCT=-15
TC_LOSS_BOUNCE_PCT=-5
TC_LOOKBACK_DAYS=7
TC_MAX_OPEN_POSITIONS=25
TC_POLL_SEC=30
TC_SCAN_DELAY_SEC=120
TC_EVAL_DELAY_SEC=90
TC_FEE_RT=0.0008
TC_LEVERAGE_CAP=20
TC_FLATTEN_RETRIES=4
TC_MAX_DAILY_LOSS_USDT=15
