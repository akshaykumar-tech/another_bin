# Trading bots — copy to .env and fill keys

BINANCE_API_KEY=
BINANCE_API_SECRET=

# Global live sizing — shared by live bots
LIVE_NOTIONAL_USDT=6
LIVE_MAX_OPEN=40
LIVE_MIN_LEVERAGE=10
LIVE_MARGIN_BUFFER=1.05
LIVE_RECONCILE_SEC=60
LIVE_ALGO_WORKING_TYPE=CONTRACT_PRICE
LIVE_SL_PCT=8
LIVE_TP_PCT=1.5

# PB9 combo CONT pullback (scripts/pb9_combo_bot.py)
# A: prior |c2c|>50% → CONT @ open±9% first 4h UTC
# B: cum2d |move|>50% → CONT @ open±9% full day (no A same sym/day)
# Dry: PB9_LIVE_ENABLED=false | Live: PB9_LIVE_ENABLED=true + BINANCE_API_KEY/SECRET
PB9_LIVE_ENABLED=false
PB9_FAPI=https://fapi.binance.com
PB9_OUT_DIR=data/aws/pb9_combo
PB9_NOTIONAL_USDT=6
PB9_THR_A=50
PB9_THR_B=50
PB9_PB_PCT=9
PB9_MAX_OPEN_POSITIONS=20
PB9_POLL_SEC=15
PB9_SCAN_DELAY_SEC=90
PB9_FEE_RT=0.0008
PB9_LEVERAGE_CAP=20
PB9_FLATTEN_RETRIES=4
PB9_MAX_DAILY_LOSS_USDT=15
PB9_DAILY_LOOKBACK_DAYS=10

# C60 triple: cum60 pb9 + >40 pb9 + down15@open (scripts/c60_triple_bot.py)
# Dry: C60_LIVE_ENABLED=false | Live: C60_LIVE_ENABLED=true + BINANCE_API_KEY/SECRET
C60_LIVE_ENABLED=false
C60_FAPI=https://fapi.binance.com
C60_OUT_DIR=data/aws/c60_triple
C60_NOTIONAL_USDT=6
C60_CUM_THR=60
C60_L40_THR=40
C60_DOWN_THR=15
C60_DOWN_SKIP_ABS=40
C60_DOWN_DELAY_BARS=3
C60_PB_PCT=9
C60_MAX_OPEN_POSITIONS=25
C60_POLL_SEC=15
C60_SCAN_DELAY_SEC=90
C60_FEE_RT=0.0008
C60_LEVERAGE_CAP=20
C60_FLATTEN_RETRIES=4
C60_MAX_DAILY_LOSS_USDT=20
C60_DAILY_LOOKBACK_DAYS=10

# Pump-fade c20_s2 top_uw ND hold10 (scripts/hold10_n246_p126_bot.py)
# Research ≈ n229 / +$135 May–Jul18 @ $6 | c22 + delay30m | hold10
# Dry: H10_LIVE_ENABLED=false | Live: H10_LIVE_ENABLED=true + BINANCE_API_KEY/SECRET
H10_LIVE_ENABLED=false
H10_FAPI=https://fapi.binance.com
H10_OUT_DIR=data/aws/hold10_n246_p126
H10_NOTIONAL_USDT=6
H10_CUM_PCT=22
H10_STREAK_MIN=2
H10_CLOSE_LOC_MIN=0.75
H10_UW_PCT=2
H10_HOLD_DAYS=10
H10_ENTRY_DELAY_BARS=6
H10_MAX_OPEN_POSITIONS=40
H10_POLL_SEC=30
H10_SCAN_DELAY_SEC=90
H10_EXIT_BEFORE_MIDNIGHT_SEC=120
H10_FEE_RT=0.0008
H10_LEVERAGE_CAP=20
H10_FLATTEN_RETRIES=4
H10_DAILY_LOOKBACK_DAYS=45
H10_UNIVERSE_LIMIT=0

# Quiet3 ladder TP30 (scripts/winbe_hedge_bot.py) — Best +$246 research
# quiet3 + prev |c2c|≥30% → same-side ladder open ±8/10/12/15%, TP30, max 3/level, EOD
# Dry: WINBE_LIVE_ENABLED=false | Live: true + BINANCE_API_KEY/SECRET
WINBE_FAPI=https://fapi.binance.com
WINBE_OUT_DIR=data/aws/winbe_hedge
WINBE_LIVE_ENABLED=false
WINBE_NOTIONAL_USDT=6
WINBE_PREV_THR=30
WINBE_QUIET_MAX=10
WINBE_LEVELS=8,10,12,15
WINBE_TP_PCT=30
WINBE_MAX_PER_LEVEL=3
WINBE_MAX_OPEN_LEGS=80
WINBE_POLL_SEC=30
WINBE_SCAN_DELAY_SEC=90
WINBE_EXIT_BEFORE_MIDNIGHT_SEC=120
WINBE_FEE_RT=0.0008
WINBE_LEVERAGE_CAP=20
WINBE_FLATTEN_RETRIES=4
WINBE_DAILY_LOOKBACK_DAYS=12
WINBE_UNIVERSE_LIMIT=0
# false = mid-day start pe purani candles replay mat karo
WINBE_REPLAY_TODAY=false

# RSI FADE UP70 reclaim (scripts/rsi_reclaim_bot.py)
# RSI(7)≥70 touch → leave below → reclaim ≥70 → SHORT next open; hold N days
# Hold=5 July-friendlier; RSI_HOLD_DAYS=8 for research max tot
# Dry: RSI_LIVE_ENABLED=false | Live: true + BINANCE_API_KEY/SECRET
RSI_LIVE_ENABLED=false
RSI_FAPI=https://fapi.binance.com
RSI_OUT_DIR=data/aws/rsi_reclaim
RSI_NOTIONAL_USDT=6
RSI_PERIOD=7
RSI_THR=70
RSI_HOLD_DAYS=5
RSI_MAX_ARM_DAYS=15
RSI_MAX_OPEN_POSITIONS=40
RSI_POLL_SEC=30
RSI_SCAN_DELAY_SEC=90
RSI_EXIT_BEFORE_MIDNIGHT_SEC=120
RSI_FEE_RT=0.0008
RSI_LEVERAGE_CAP=20
RSI_FLATTEN_RETRIES=4
RSI_DAILY_LOOKBACK_DAYS=60
RSI_UNIVERSE_LIMIT=0

# Pyramid L15 no-leg-limit fade (scripts/pyramid_l15_bot.py)
# L15 first-touch ≥30% → SHORT next open; +$6 each +10% from anchor; exit close≤anchor
# Dry: PYR_LIVE_ENABLED=false | Live: true + BINANCE_API_KEY/SECRET
PYR_LIVE_ENABLED=false
PYR_FAPI=https://fapi.binance.com
PYR_OUT_DIR=data/aws/pyramid_l15
PYR_NOTIONAL_USDT=6
PYR_LOOKBACK=15
PYR_START_PCT=30
PYR_STEP_PCT=10
PYR_MAX_LEGS=99
# 0 = until-recovery (canonical); set e.g. 45 for H45
PYR_MAX_HOLD_DAYS=0
PYR_MIN_LIFE_DAYS=90
PYR_MAX_OPEN_BOOKS=80
PYR_POLL_SEC=60
PYR_MANAGE_DELAY_SEC=90
PYR_SCAN_DELAY_SEC=120
PYR_FEE_RT=0.0008
PYR_LEVERAGE_CAP=50
PYR_DAILY_LOOKBACK_DAYS=400
PYR_UNIVERSE_LIMIT=0
