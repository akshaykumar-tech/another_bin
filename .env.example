DATABASE_URL=postgres://postgres:postgres@localhost:5432/crypto_announcements_development?sslmode=disable

# --- trading_settings table (same column names as Rails `crypto_announcements`) ---
# Stop loss is read from PostgreSQL, not from env. Set manually e.g. in psql / Admin:
#   stop_loss_enabled   boolean   (default true in Rails migration)
#   stop_loss_percent   decimal   (e.g. 2.0 means 2%)
# Example:
#   UPDATE trading_settings SET stop_loss_enabled = true, stop_loss_percent = 2.0 WHERE id = 1;
# Announcement actions are also read from DB JSON column `announcement_actions`.
# For current classifier types, map keys such as:
#   listing -> open_long
#   delisting -> open_short
#   ecosystem_positive -> open_long (optional)
#   risk_warning -> open_short (optional)
#   maintenance -> none

ANNOUNCEMENT_SERVICE_MODE=all

BINANCE_WS_ENABLED=true
BINANCE_CMS_WS_BASE_URL=wss://api.binance.com/sapi/wss
BINANCE_CMS_TOPIC=com_announcement_en
BINANCE_API_KEY=
BINANCE_API_SECRET=

UPBIT_ANNOUNCEMENTS_API_URL=https://api-manager.upbit.com/api/v1/announcements
UPBIT_POLL_INTERVAL_SECONDS=5
UPBIT_ANNOUNCEMENTS_API_PER_PAGE=1
UPBIT_ANNOUNCEMENTS_ONLY_LATEST=true
# If true, log each unclassified Upbit notice every poll (very noisy). Default: omit or false.
UPBIT_LOG_SKIPPED_UNCLASSIFIED=false

AUTO_TRADING_ENABLED=true
AUTO_TRADING_DRY_RUN=false
AUTO_TRADING_RECENT_MOVE_FILTER_ENABLED=true
AUTO_TRADING_RECENT_MOVE_LOOKBACK_SECONDS=20
AUTO_TRADING_RECENT_MOVE_SKIP_PERCENT=10
AUTO_TRADING_ULTRA_FAST_FIXED_MARGIN_USDT=20

# --- Whale burst bot (cmd/whale) ---
# WHALE_CONFIG=config/whale.yaml
WHALE_DRY_RUN=true
WHALE_REVERSE_LIVE=false
WHALE_ALLOCATION_PERCENT=5
WHALE_MAX_LEVERAGE=50
# Sim/paper only (dry-run ENTRY margin). Reverse live uses live Binance balance × ALLOCATION_PERCENT.
WHALE_CAPITAL_USDT=1000
WHALE_DRY_SIM_MODE=tick
WHALE_TRADE_LOG=whale-trades.log
