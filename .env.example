# Trading bots — copy to .env and fill keys

BINANCE_API_KEY=
BINANCE_API_SECRET=

# Global live sizing — shared by ACCEL5X / TPB live bots
LIVE_NOTIONAL_USDT=6
LIVE_MAX_OPEN=40
LIVE_MIN_LEVERAGE=10
LIVE_MARGIN_BUFFER=1.05
LIVE_RECONCILE_SEC=60
LIVE_ALGO_WORKING_TYPE=CONTRACT_PRICE
LIVE_SL_PCT=8
LIVE_TP_PCT=1.5

# 5x acceleration dry paper (scripts/accel5x_dry_paper.py)
ACCEL5X_DRY_OUT_DIR=data/aws/accel5x_dry
ACCEL5X_LIVE_ENABLED=false
ACCEL5X_ENTRY_MODE=hyb5
ACCEL5X_HYB_ADVERSE_PCT=5
ACCEL5X_HYB_POLL_SEC=30
ACCEL5X_HYB_OPEN_AFTER_SEC=0
ACCEL5X_MIN_MULT=5
ACCEL5X_MIN_BASE_PCT=0.3
ACCEL5X_MAX_TRADES=30
ACCEL5X_FEE_RT=0.0008
ACCEL5X_SLIP_BPS=1.0
# BTC twist (dry+live): GREEN=same | RED=mirror | exit next day, no SL/TP
# HYB5: enter when price hits adverse% vs day open, else open ref after OPEN_AFTER sec
# Live uses LIVE_NOTIONAL_USDT, LIVE_MAX_OPEN, LIVE_MIN_LEVERAGE, LIVE_MARGIN_BUFFER, LIVE_RECONCILE_SEC

# Trend + Pullback: dry original + live sync-mirror (scripts/trend_pullback_bot.py)
TPB_DRY_OUT_DIR=data/aws/trend_pullback
TPB_LIVE_ENABLED=false
TPB_WATCHLIST_MODE=all_perps
TPB_WATCHLIST_SIZE=300
TPB_WS_CHUNK=40
# Optional manual override: TPB_SYMBOLS=BTCUSDT,ETHUSDT
TPB_MAX_TRADES_DAY=500
TPB_DRY_NOTIONAL_USDT=6
TPB_FEE_RT=0.0008
TPB_SLIP_BPS=1.0
TPB_STATS_INTERVAL_SEC=1800
TPB_BANKROLL_USDT=100
TPB_BOOTSTRAP_BARS=250
TPB_MARK_POLL_SEC=45
TPB_FAPI=https://fapi.binance.com
TPB_WS_ROOT=wss://fstream.binance.com
# Live mirror uses LIVE_NOTIONAL_USDT, LIVE_MAX_OPEN, BINANCE_API_KEY, etc.

# ORB 30m top-mover breakout (scripts/orb30_bot.py)
# Dry: ORB30_LIVE_ENABLED=false | Live: ORB30_LIVE_ENABLED=true
ORB30_LIVE_ENABLED=false
ORB30_FAPI=https://fapi.binance.com
ORB30_OUT_DIR=data/aws/orb30
ORB30_NOTIONAL_USDT=10
ORB30_TP_PCT=10
ORB30_SL_PCT=10
ORB30_MAX_TRADES_PER_SYM=3
ORB30_MAX_OPEN_POSITIONS=3
ORB30_LOOKBACK_DAYS=7
ORB30_POLL_SEC=3
ORB30_SCAN_DELAY_SEC=120
ORB30_FEE_RT=0.0008
ORB30_LEVERAGE_CAP=20
ORB30_FLATTEN_RETRIES=4
ORB30_MAX_DAILY_LOSS_USDT=10
