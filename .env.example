IFVG_DRY_STATS_INTERVAL_SEC=1800
IFVG_DRY_RUN_DAYS=7
IFVG_DRY_OUT_DIR=data/aws/sr_chartprime/ifvg_dry
IFVG_DRY_H1_ENABLED=true
