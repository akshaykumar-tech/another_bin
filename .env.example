# Early watch live bot (cmd/whale-early) — copy to .env on AWS and fill keys

BINANCE_API_KEY=
BINANCE_API_SECRET=

EARLY_DRY_RUN=true
EARLY_LIVE_TRADE=false

# Vol3 same-direction: quiet_flat + vol≥3, limit entry (GTX on Binance), TP @ 0.93% or hold 30m
EARLY_DRY_SAME=true
EARLY_DRY_REVERSE_LIMIT=false
EARLY_MIN_VOL_ACCEL=3
EARLY_TAKE_PROFIT_PCT=0.93
EARLY_LIMIT_FILL_SEC=1800

# Same-direction tick dry sizing
EARLY_SAME_MARGIN_USDT=1
EARLY_SAME_LEVERAGE=10
# EARLY_SAME_ALLOCATION_PERCENT=25

# Reverse limit dry sizing (fallback: EARLY_MARGIN_USDT / EARLY_LEVERAGE)
EARLY_REVERSE_MARGIN_USDT=1
EARLY_REVERSE_LEVERAGE=10
# EARLY_REVERSE_ALLOCATION_PERCENT=25

# Same-direction market on Binance (requires API keys above)
EARLY_LIVE_TRADE=false
EARLY_NOTIONAL_USDT=10
EARLY_MAX_OPEN_LIVE=3

EARLY_MARGIN_USDT=1
# EARLY_ALLOCATION_PERCENT=25
EARLY_LEVERAGE=10
EARLY_MAX_LEVERAGE=50
EARLY_CAPITAL_USDT=1000

EARLY_WATCHLIST_MODE=lowest_volume
EARLY_WATCHLIST_SIZE=100

EARLY_RULE=quiet_flat
EARLY_DIRECTION=trend_1h

EARLY_TRADE_LOG=early-trades.log
EARLY_FOCUS_COOLDOWN_SEC=120
