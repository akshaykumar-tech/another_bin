# Trading bots — copy to .env and fill keys

BINANCE_API_KEY=
BINANCE_API_SECRET=

# Global live sizing — shared by ACCEL5X / TPB live bots
LIVE_NOTIONAL_USDT=6
LIVE_MAX_OPEN=40
LIVE_MIN_LEVERAGE=10
LIVE_MARGIN_BUFFER=1.05
LIVE_RECONCILE_SEC=60
LIVE_ALGO_WORKING_TYPE=CONTRACT_PRICE
LIVE_SL_PCT=8
LIVE_TP_PCT=1.5

# 5x acceleration dry paper (scripts/accel5x_dry_paper.py)
ACCEL5X_DRY_OUT_DIR=data/aws/accel5x_dry
ACCEL5X_LIVE_ENABLED=false
ACCEL5X_ENTRY_MODE=hyb5
ACCEL5X_HYB_ADVERSE_PCT=5
ACCEL5X_HYB_POLL_SEC=30
# Full-day watch (86400=24h). 0=instant fallback on first poll if no 5% touch yet.
ACCEL5X_HYB_OPEN_AFTER_SEC=86400
ACCEL5X_MIN_MULT=5
ACCEL5X_MIN_BASE_PCT=0.3
ACCEL5X_MAX_TRADES=30
ACCEL5X_FEE_RT=0.0008
ACCEL5X_SLIP_BPS=1.0
# BTC twist (dry+live): GREEN=same | RED=mirror | exit next day, no SL/TP
# HYB5: first adverse% touch since day open -> trigger entry (latched); else market @ OPEN_AFTER
# Live uses LIVE_NOTIONAL_USDT, LIVE_MAX_OPEN, LIVE_MIN_LEVERAGE, LIVE_MARGIN_BUFFER, LIVE_RECONCILE_SEC

# Triple-combo overnight (scripts/triple_combo_bot.py)
# Dry: TC_LIVE_ENABLED=false | Live: TC_LIVE_ENABLED=true
TC_LIVE_ENABLED=false
TC_FAPI=https://fapi.binance.com
TC_OUT_DIR=data/aws/triple_combo
TC_NOTIONAL_USDT=10
TC_GAIN_FADE_PCT=-15
TC_LOSS_BOUNCE_PCT=-5
TC_LOOKBACK_DAYS=7
TC_MAX_OPEN_POSITIONS=25
TC_POLL_SEC=30
TC_SCAN_DELAY_SEC=120
TC_EVAL_DELAY_SEC=90
TC_FEE_RT=0.0008
TC_LEVERAGE_CAP=20
TC_FLATTEN_RETRIES=4
TC_MAX_DAILY_LOSS_USDT=15

# PB9 combo CONT pullback (scripts/pb9_combo_bot.py)
# A: prior |c2c|>50% → CONT @ open±9% first 4h UTC
# B: cum2d |move|>50% → CONT @ open±9% full day (no A same sym/day)
# Dry: PB9_LIVE_ENABLED=false | Live: PB9_LIVE_ENABLED=true + BINANCE_API_KEY/SECRET
PB9_LIVE_ENABLED=false
PB9_FAPI=https://fapi.binance.com
PB9_OUT_DIR=data/aws/pb9_combo
PB9_NOTIONAL_USDT=6
PB9_THR_A=50
PB9_THR_B=50
PB9_PB_PCT=9
PB9_MAX_OPEN_POSITIONS=20
PB9_POLL_SEC=15
PB9_SCAN_DELAY_SEC=90
PB9_FEE_RT=0.0008
PB9_LEVERAGE_CAP=20
PB9_FLATTEN_RETRIES=4
PB9_MAX_DAILY_LOSS_USDT=15
PB9_DAILY_LOOKBACK_DAYS=10

# C60 triple: cum60 pb9 + >40 pb9 + down15@open (scripts/c60_triple_bot.py)
# Dry: C60_LIVE_ENABLED=false | Live: C60_LIVE_ENABLED=true + BINANCE_API_KEY/SECRET
C60_LIVE_ENABLED=false
C60_FAPI=https://fapi.binance.com
C60_OUT_DIR=data/aws/c60_triple
C60_NOTIONAL_USDT=6
C60_CUM_THR=60
C60_L40_THR=40
C60_DOWN_THR=15
C60_PB_PCT=9
C60_MAX_OPEN_POSITIONS=25
C60_POLL_SEC=15
C60_SCAN_DELAY_SEC=90
C60_FEE_RT=0.0008
C60_LEVERAGE_CAP=20
C60_FLATTEN_RETRIES=4
C60_MAX_DAILY_LOSS_USDT=20
C60_DAILY_LOOKBACK_DAYS=10
