# Trading bots — copy to .env and fill keys

BINANCE_API_KEY=
BINANCE_API_SECRET=

# Global live sizing — shared by SNR + IFVG 1h live bots
LIVE_NOTIONAL_USDT=6
LIVE_MAX_OPEN=40
LIVE_MIN_LEVERAGE=10
LIVE_MARGIN_BUFFER=1.05
LIVE_RECONCILE_SEC=60
LIVE_ALGO_WORKING_TYPE=CONTRACT_PRICE
LIVE_SL_PCT=8
LIVE_TP_PCT=1.5

# Smarter SnR dry paper (scripts/smarter_snr_paper.py) — snr_cross_tp15_sl8, 300 perps
SNR_DRY_WATCHLIST_MODE=all_perps
SNR_DRY_WATCHLIST_SIZE=300
SNR_DRY_INTERVAL=5m
SNR_DRY_NOTIONAL_USDT=6
SNR_DRY_BANKROLL_USDT=100
SNR_DRY_SL_PCT=8
SNR_DRY_TP_PCT=1.5
SNR_DRY_MAX_HOLD_BARS=288
SNR_DRY_WS_CHUNK=40
SNR_DRY_BOOTSTRAP_KLINES=300
SNR_DRY_STATS_INTERVAL_SEC=1800
SNR_DRY_RUN_DAYS=7
SNR_DRY_OUT_DIR=data/aws/snr_dry
SNR_DRY_BTC_CORR_LINKED_MIN=0.60
SNR_DRY_BTC_CORR_INDEP_MAX=0.40
SNR_DRY_BTC_CORR_KLINES=500
SNR_DRY_BTC_REGIME_ATR_LEN=14
SNR_DRY_BTC_REGIME_REV_ATR_MULT=8.0
SNR_DRY_BTC_REGIME_REV_MIN=250
SNR_DRY_BTC_REGIME_REV_MAX=1800
SNR_DRY_BTC_REGIME_NEUTRAL_ATR_MULT=2.0
SNR_DRY_BTC_REGIME_NEUTRAL_MIN=100
# SNR live r_cu orders — sizing via LIVE_*
SNR_LIVE_ENABLED=false

# IFVG dry paper bot (scripts/ifvg_dry_paper.py) — 5m + 1h Pine Sniper (trading1.log)
IFVG_DRY_WATCHLIST_MODE=all_perps
IFVG_DRY_WATCHLIST_SIZE=300
IFVG_DRY_INTERVAL=5m
IFVG_DRY_NOTIONAL_USDT=100
IFVG_DRY_BANKROLL_USDT=100
IFVG_DRY_FEE_RT=0.0008
IFVG_DRY_SLIPPAGE_BPS=1.0
IFVG_DRY_ATR_LEN=14
IFVG_DRY_SL_ATR_MULT=1.5
IFVG_DRY_TP_RR=3.0
IFVG_DRY_MAX_HIDDEN_FVG=120
IFVG_DRY_MAX_FVG_AGE=60
IFVG_DRY_Q_GAP_ATR=0.25
IFVG_DRY_Q_BODY_RATIO=0.50
IFVG_DRY_Q_RANGE_ATR=0.60
IFVG_DRY_INV_BUF_ATR=0.05
IFVG_DRY_WS_CHUNK=40
IFVG_DRY_BOOTSTRAP_KLINES=300
IFVG_DRY_STATS_INTERVAL_SEC=1800
IFVG_DRY_RUN_DAYS=7
IFVG_DRY_OUT_DIR=data/aws/ifvg_dry
IFVG_DRY_H1_ENABLED=true
# Pine entryMode for 5m/1h: ifvg_line (Broken Boundary) or confirm_close
IFVG_5M_ENTRY_MODE=ifvg_line
IFVG_H1_ENTRY_MODE=ifvg_line
# Legacy 1h live (old first-1min strategy) — disabled; dry uses Pine 1h above
IFVG_H1_LIVE_ENABLED=false

# 5x acceleration dry paper (scripts/accel5x_dry_paper.py) — ALL mix backtest parity
ACCEL5X_DRY_OUT_DIR=data/aws/accel5x_dry
ACCEL5X_LIVE_ENABLED=false
ACCEL5X_MIN_MULT=5
ACCEL5X_MIN_BASE_PCT=0.3
ACCEL5X_MAX_TRADES=30
ACCEL5X_FEE_RT=0.0008
ACCEL5X_SLIP_BPS=1.0
# Live uses LIVE_NOTIONAL_USDT, LIVE_MAX_OPEN, LIVE_MIN_LEVERAGE, LIVE_MARGIN_BUFFER, LIVE_RECONCILE_SEC
# Live twist: BTC prev GREEN -> same direction | RED -> mirror | no SL/TP

# Strong Pullback dry paper bot (scripts/pullback_dry_paper.py) — 1h + 4h HTF (trading1.log)
PULLBACK_DRY_WATCHLIST_MODE=all_perps
PULLBACK_DRY_WATCHLIST_SIZE=300
PULLBACK_DRY_INTERVAL=1h
PULLBACK_DRY_H4_INTERVAL=4h
PULLBACK_DRY_NOTIONAL_USDT=6
PULLBACK_DRY_BANKROLL_USDT=100
PULLBACK_DRY_FEE_RT=0.0008
PULLBACK_DRY_SLIPPAGE_BPS=1.0
PULLBACK_DRY_WS_CHUNK=40
PULLBACK_DRY_BOOTSTRAP_KLINES=300
PULLBACK_DRY_BOOTSTRAP_H4=80
PULLBACK_DRY_STATS_INTERVAL_SEC=1800
PULLBACK_DRY_RUN_DAYS=7
PULLBACK_DRY_OUT_DIR=data/aws/pullback_dry
