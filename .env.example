# Early watch live bot (cmd/whale-early) — copy to .env on AWS and fill keys

BINANCE_API_KEY=
BINANCE_API_SECRET=

EARLY_DRY_RUN=true
EARLY_LIVE_TRADE=false

# Vol3 same-direction: quiet_flat + vol≥3, limit entry (GTX on Binance), TP @ 0.93% or hold 30m
EARLY_DRY_SAME=true
EARLY_DRY_REVERSE_LIMIT=false
EARLY_MIN_VOL_ACCEL=3
EARLY_TAKE_PROFIT_PCT=0.93
EARLY_LIMIT_FILL_SEC=1800

# Same-direction tick dry sizing
EARLY_SAME_MARGIN_USDT=1
EARLY_SAME_LEVERAGE=10
# EARLY_SAME_ALLOCATION_PERCENT=25

# Reverse limit dry sizing (fallback: EARLY_MARGIN_USDT / EARLY_LEVERAGE)
EARLY_REVERSE_MARGIN_USDT=1
EARLY_REVERSE_LEVERAGE=10
# EARLY_REVERSE_ALLOCATION_PERCENT=25

# Same-direction market on Binance (requires API keys above)
EARLY_LIVE_TRADE=false
EARLY_NOTIONAL_USDT=10
EARLY_MAX_OPEN_LIVE=3

EARLY_MARGIN_USDT=1
# EARLY_ALLOCATION_PERCENT=25
EARLY_LEVERAGE=10
EARLY_MAX_LEVERAGE=50
EARLY_CAPITAL_USDT=1000

EARLY_WATCHLIST_MODE=lowest_volume
EARLY_WATCHLIST_SIZE=300

# --- Live paper detector (scripts/live_paper.py) ---
LIVE_PAPER_WATCHLIST_SIZE=300
LIVE_PAPER_WS_CHUNK=80
LIVE_PAPER_PRE_THRESH=0.02
LIVE_PAPER_EVENT_THRESH=0.06
LIVE_PAPER_WINDOW_SEC=60
LIVE_PAPER_COOLDOWN_SEC=3600

# --- Focused 6% sig_open paper (scripts/focused_paper.py) ---
FOCUSED_CONFIG=config/whale-focused.yaml
FOCUSED_WATCHLIST_MODE=all_perps
FOCUSED_WATCHLIST_SIZE=500
FOCUSED_WS_CHUNK=80
FOCUSED_STATS_INTERVAL_SEC=1800
FOCUSED_LIVE_TRADE=false
FOCUSED_NOTIONAL_USDT=10
FOCUSED_MAX_OPEN_ORDERS=2
FOCUSED_HOLD_SEC=300
FOCUSED_BINANCE_API_KEY=
FOCUSED_BINANCE_API_SECRET=
KLINE_FETCH_HOURS=24

# Alma ST dry paper (scripts/alma_st_dry_paper.py — dual_flip_consensus + live mirror)
ALMA_ST_NOTIONAL_USDT=6
ALMA_ST_BINANCE_LIVE=false
ALMA_ST_MAX_OPEN_LIVE=22
ALMA_ST_MIN_LEVERAGE=50
ALMA_ST_MARGIN_BUFFER=1.05
ALMA_ST_LIVE_MIRROR_SL_PCT=8
ALMA_ST_LIVE_MIRROR_TP_PCT=1.5
ALMA_ST_ALGO_WORKING_TYPE=CONTRACT_PRICE
ALMA_ST_LIVE_RECONCILE_SEC=60
ALMA_ST_LIVE_MIRROR_SKIP_BINANCE_LONG=false
ALMA_ST_LIVE_MIRROR_SKIP_BINANCE_SHORT=true

# ChartPrime SR dry paper (scripts/sr_chartprime_paper.py) — 500 perps default
SR_CHARTPRIME_WATCHLIST_MODE=all_perps
SR_CHARTPRIME_WATCHLIST_SIZE=500
SR_CHARTPRIME_INTERVAL=5m
SR_CHARTPRIME_LOOKBACK=20
SR_CHARTPRIME_VOL_LEN=2
SR_CHARTPRIME_BOX_WIDTH=1.0
SR_CHARTPRIME_SIGNAL_MODE=all
SR_CHARTPRIME_NOTIONAL_USDT=6
SR_CHARTPRIME_SL_PCT=8
SR_CHARTPRIME_TP_PCT=1.5
SR_CHARTPRIME_MAX_HOLD_BARS=288
SR_CHARTPRIME_WS_CHUNK=40
SR_CHARTPRIME_BOOTSTRAP_KLINES=300
SR_CHARTPRIME_STATS_INTERVAL_SEC=1800
# God-mode fakeout/breakout (same bot, separate godmode_dry.log)
SR_GODMODE_ENABLED=true
SR_GODMODE_LOOKBACK=15
SR_GODMODE_VOL_MA=20
SR_GODMODE_VOL_SPIKE=1.4
SR_GODMODE_WICK_RATIO=0.55
SR_GODMODE_SKIP_BREAKDOWN=true
SR_GODMODE_MAX_HOLD_BARS=288
# Live Binance: fakeout_res only (same side as dry, no mirror)
SR_GODMODE_LIVE_ENABLED=false
SR_GODMODE_LIVE_SETUP=fakeout_res
SR_GODMODE_LIVE_NOTIONAL_USDT=6
SR_GODMODE_LIVE_SL_PCT=8
SR_GODMODE_LIVE_TP_PCT=1.5
SR_GODMODE_LIVE_MAX_OPEN=30
SR_GODMODE_LIVE_MIN_LEVERAGE=50
SR_GODMODE_LIVE_MARGIN_BUFFER=1.05
SR_GODMODE_LIVE_RECONCILE_SEC=60
SR_GODMODE_LIVE_ALGO_WORKING_TYPE=CONTRACT_PRICE
# SR_GODMODE_BINANCE_API_KEY=  # falls back to BINANCE_API_KEY
# SR_GODMODE_BINANCE_API_SECRET=  # falls back to BINANCE_API_SECRET

EARLY_RULE=quiet_flat
EARLY_DIRECTION=trend_1h

EARLY_TRADE_LOG=early-trades.log
EARLY_FOCUS_COOLDOWN_SEC=120
