# Trading bots — copy to .env and fill keys

BINANCE_API_KEY=
BINANCE_API_SECRET=

# Alma ST dry paper (scripts/alma_st_dry_paper.py — dual_flip_consensus + live mirror)
ALMA_ST_NOTIONAL_USDT=6
ALMA_ST_BINANCE_LIVE=false
ALMA_ST_MAX_OPEN_LIVE=22
ALMA_ST_MIN_LEVERAGE=50
ALMA_ST_MARGIN_BUFFER=1.05
ALMA_ST_LIVE_MIRROR_SL_PCT=8
ALMA_ST_LIVE_MIRROR_TP_PCT=1.5
ALMA_ST_ALGO_WORKING_TYPE=CONTRACT_PRICE
ALMA_ST_LIVE_RECONCILE_SEC=60
ALMA_ST_LIVE_MIRROR_SKIP_BINANCE_LONG=false
ALMA_ST_LIVE_MIRROR_SKIP_BINANCE_SHORT=true

# God-mode fakeout_res dry + live (scripts/sr_chartprime_paper.py) — 500 perps
SR_CHARTPRIME_WATCHLIST_MODE=all_perps
SR_CHARTPRIME_WATCHLIST_SIZE=500
SR_CHARTPRIME_INTERVAL=5m
SR_CHARTPRIME_NOTIONAL_USDT=6
SR_CHARTPRIME_SL_PCT=8
SR_CHARTPRIME_TP_PCT=1.5
SR_CHARTPRIME_MAX_HOLD_BARS=288
SR_CHARTPRIME_WS_CHUNK=40
SR_CHARTPRIME_BOOTSTRAP_KLINES=300
SR_CHARTPRIME_STATS_INTERVAL_SEC=1800
SR_CHARTPRIME_DRY_ENABLED=false
SR_GODMODE_SETUPS=fakeout_res
SR_BTC_CORR_LINKED_MIN=0.60
SR_BTC_CORR_INDEP_MAX=0.40
SR_BTC_CORR_KLINES=500
# Legacy ChartPrime SR dry only (if SR_CHARTPRIME_DRY_ENABLED=true):
# SR_CHARTPRIME_LOOKBACK=20 SR_CHARTPRIME_VOL_LEN=2 SR_CHARTPRIME_BOX_WIDTH=1.0 SR_CHARTPRIME_SIGNAL_MODE=all
# God-mode signal params + live Binance
SR_GODMODE_ENABLED=true
SR_GODMODE_LOOKBACK=15
SR_GODMODE_VOL_MA=20
SR_GODMODE_VOL_SPIKE=1.4
SR_GODMODE_WICK_RATIO=0.55
SR_GODMODE_SKIP_BREAKDOWN=true
SR_GODMODE_MAX_HOLD_BARS=288
# Live Binance: fakeout_res only (same side as dry, no mirror)
SR_GODMODE_LIVE_ENABLED=false
SR_GODMODE_LIVE_SETUP=fakeout_res
# Live entry scope: all | btc_independent (admin JSON overrides at runtime)
SR_GODMODE_LIVE_SYMBOL_SCOPE=all
SR_GODMODE_ADMIN_CONFIG=data/admin/godmode_live.json
SR_GODMODE_LIVE_NOTIONAL_USDT=6
SR_GODMODE_LIVE_SL_PCT=8
SR_GODMODE_LIVE_TP_PCT=1.5
SR_GODMODE_LIVE_MAX_OPEN=30
SR_GODMODE_LIVE_MIN_LEVERAGE=50
SR_GODMODE_LIVE_MARGIN_BUFFER=1.05
SR_GODMODE_LIVE_RECONCILE_SEC=60
SR_GODMODE_LIVE_ALGO_WORKING_TYPE=CONTRACT_PRICE
# SR_GODMODE_BINANCE_API_KEY=  # falls back to BINANCE_API_KEY
# SR_GODMODE_BINANCE_API_SECRET=  # falls back to BINANCE_API_SECRET

# Smarter SnR dry paper (scripts/smarter_snr_paper.py) — snr_cross_tp15_sl8, 300 perps
SNR_DRY_WATCHLIST_MODE=all_perps
SNR_DRY_WATCHLIST_SIZE=300
SNR_DRY_INTERVAL=5m
SNR_DRY_NOTIONAL_USDT=6
SNR_DRY_BANKROLL_USDT=100
SNR_DRY_SL_PCT=8
SNR_DRY_TP_PCT=1.5
SNR_DRY_MAX_HOLD_BARS=288
SNR_DRY_WS_CHUNK=40
SNR_DRY_BOOTSTRAP_KLINES=300
SNR_DRY_STATS_INTERVAL_SEC=1800
SNR_DRY_RUN_DAYS=7
SNR_DRY_OUT_DIR=data/aws/sr_chartprime/snr_dry
SNR_DRY_BTC_CORR_LINKED_MIN=0.60
SNR_DRY_BTC_CORR_INDEP_MAX=0.40
SNR_DRY_BTC_CORR_KLINES=500
SNR_DRY_BTC_REGIME_ATR_LEN=14
SNR_DRY_BTC_REGIME_REV_ATR_MULT=8.0
SNR_DRY_BTC_REGIME_REV_MIN=250
SNR_DRY_BTC_REGIME_REV_MAX=1800
SNR_DRY_BTC_REGIME_NEUTRAL_ATR_MULT=2.0
SNR_DRY_BTC_REGIME_NEUTRAL_MIN=100
# SNR live r_cu orders — toggle separate from godmode (SR_GODMODE_LIVE_ENABLED)
SNR_LIVE_ENABLED=false

# IFVG dry paper bot (scripts/ifvg_dry_paper.py) — parity with backtest_ifvg_btc_parity.py
IFVG_DRY_WATCHLIST_MODE=all_perps
IFVG_DRY_WATCHLIST_SIZE=300
IFVG_DRY_INTERVAL=5m
IFVG_DRY_NOTIONAL_USDT=100
IFVG_DRY_BANKROLL_USDT=100
